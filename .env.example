# Copy to .env and fill in. Never commit .env.
# ---------- Strands Decider 2B (hosted decision cloud) ----------
DECIDER_BASE_URL=https://da25tnxy06gjk.cloudfront.net   # AWS User Group Madurai hosted Decider API
DECIDER_API_KEY=<<paste-your-decider-api-key-here>>
DECIDER_AUTH_HEADER=Authorization                       # sent as "Authorization: Bearer <key>"
DECIDER_MODEL_ID=strands-decider-2b-hobson-v19          # as reported by GET /v1/models
DECIDER_KIT_PATH=<<path-to-decider-hackathon-kit>>
DECIDER_TIMEOUT_S=5.0
DECIDER_MODE=hosted                     # hosted | local (python scripts/serve_local_decider.py)
DECIDER_LOCAL_URL=http://127.0.0.1:8099
FALLBACK_MODE=nova_pro                  # when Decider is unsure: nova_micro | nova_pro | hold | none

# ---------- Amazon Bedrock (Amazon Nova only) ----------
AWS_PROFILE=                       # blank = default AWS credentials chain
AWS_REGION=us-east-1
NOVA_PLANNER_MODEL_ID=us.amazon.nova-pro-v1:0
NOVA_FAST_MODEL_ID=us.amazon.nova-micro-v1:0
BEDROCK_TIMEOUT_S=20

# ---------- App ----------
APP_MODE=real                      # real | mock
CONFIDENCE_THRESHOLD=0.30                # tuned on the variants split; see docs/BENCHMARK_METHODOLOGY.md
TICK_SECONDS=2.0
DECISION_DEADLINE_S=1.0
RESULTS_DIR=results
